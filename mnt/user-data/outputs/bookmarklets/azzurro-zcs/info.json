{
  "name": "Azzurro ZCS Suite",
  "version": "2.0.0",
  "description": "Suite completa per la gestione di dati e risorse umane su Azzurro ZCS",
  "category": "Business Tools",
  "icon": "⚡",
  "author": "pBielli",
  "dependencies": {
    "bootstrap": true,
    "exceljs": true,
    "customLibs": []
  },
  "permissions": {
    "requiresLogin": true,
    "domains": ["*.azzurrozcs.com", "azzurrozcs.com"]
  },
  "files": {
    "main": "main.js",
    "styles": null,
    "assets": []
  },
  "modules": [
    {
      "id": "manage-rh",
      "name": "Gestione RH",
      "description": "Modulo per la gestione delle risorse umane",
      "files": ["manage-rh/add_rh.js", "manage-rh/manage_rh.js", "manage-rh/select_rh.js", "manage-rh/use_rh.js"]
    },
    {
      "id": "energy-processor",
      "name": "Energy Data Processor",
      "description": "Elaborazione dati energia",
      "files": ["EnergyDataProcessor.js"]
    }
  ],
  "configuration": {
    "configurable": true,
    "settings": {
      "autoSave": true,
      "defaultFormat": "xlsx"
    }
  }
}
